# Postgres connection string
DATABASE_URL=postgresql://mindease:mindease@localhost:5432/mindease

# Session signing secret
SESSION_SECRET=change_me

# Gemini key — used by the ai-service microservice (see ai-service/.env.example)
GEMINI_API_KEY=your_gemini_api_key_here

# Base URL of the Python FastAPI AI service that now powers all AI features
# (chat/RAG/agent/vector-DB/mood/vision). Defaults to http://localhost:8000 for local dev;
# docker-compose overrides this to http://ai-service:8000 automatically.
AI_SERVICE_URL=http://localhost:8000
