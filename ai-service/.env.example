# Which provider powers chat/RAG/agent LLM calls and embeddings: "gemini" or "openai"
LLM_PROVIDER=gemini

# Gemini (default provider) — reuse the same key the Node app already uses
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# OpenAI (optional alternate provider — set LLM_PROVIDER=openai to activate)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Where the local Chroma vector store persists to disk
CHROMA_DIR=./chroma_db

# Comma-separated list of allowed CORS origins, or * for any
CORS_ORIGINS=*
